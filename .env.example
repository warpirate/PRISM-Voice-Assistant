# PRISM Environment Configuration
# Python 3.12.9 Compatible

# Nebius AI Studio API Key (REQUIRED)
# Get your free key at: https://studio.nebius.com/
NEBIUS_API_KEY=neb-your-api-key-here

# Porcupine Wake Word Detection (REQUIRED for voice activation)
# Get your FREE key at: https://console.picovoice.ai/
# Free tier: 3 devices, unlimited usage
PORCUPINE_ACCESS_KEY=your-porcupine-key-here

# SerpAPI Key (Optional - enables web search)
# Get your key at: https://serpapi.com/
SERPAPI_KEY=your-serpapi-key-here

# Use custom 'Hey PRISM' wake word via Whisper (1=yes, 0=no). If 0, Porcupine 'Computer' is used when configured.
USE_CUSTOM_WAKE=1
