# PRISM Configuration
# Copy this file to .env and fill in your values

# AI Provider Configuration
AI_PROVIDER=gemini  # Options: gemini, local
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash  # Options: gemini-2.5-flash (best quality), gemini-2.0-flash, gemini-2.0-flash-lite (fastest/cheapest)

# Voice Settings (Manual activation only)
VOICE_LANGUAGE=en-US
TTS_VOICE=default  # Text-to-speech voice
TTS_RATE=175  # Speech rate (words per minute)
TTS_VOLUME=0.9  # Volume level (0.0 to 1.0)

# System Settings
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
ENABLE_VOICE_FEEDBACK=true
MINIMIZE_TO_TRAY=true

# Privacy Settings
STORE_CONVERSATIONS=true
RETENTION_DAYS=30  # How long to keep conversation history
ENABLE_ANALYTICS=false

# UI Settings
THEME=dark  # Options: dark, light, auto
TRANSPARENCY=0.85  # Glass effect transparency (0.0 to 1.0)
ANIMATION_SPEED=normal  # Options: slow, normal, fast

# Shortcuts
ACTIVATION_HOTKEY=ctrl+space
TOGGLE_VISIBILITY_HOTKEY=ctrl+shift+p
